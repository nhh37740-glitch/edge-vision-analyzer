{
  "input": {
    "source": "http://192.168.10.12:8080/video",
    "loop": false,
    "width": 640,
    "height": 480,
    "target_fps": 15,
    "dump_interval_sec": 2
  },
  "detector": {
    "motion_mad_threshold": 8.0,
    "model_param": "models/yolo-fastest-v2.param",
    "model_bin": "models/yolo-fastest-v2.bin",
    "input_size": 320,
    "conf_threshold": 0.5,
    "num_threads": 2,
    "target_labels": [
      "person"
    ]
  },
  "event": {
    "end_grace_sec": 5,
    "max_events_in_memory": 100
  },
  "llm": {
    "enabled": true,
    "endpoint": "http://192.168.10.10:8080/v1/chat/completions",
    "api_key": "local-no-key",
    "model": "vlm-local",
    "prompt": "用一句简短的中文描述画面中人物正在做什么。",
    "cooldown_sec": 15,
    "connect_timeout_sec": 3,
    "read_timeout_sec": 25,
    "jpeg_quality": 70
  },
  "streamer": {
    "mode": "mjpeg",
    "http_port": 8081,
    "rtsp_url": "rtsp://127.0.0.1:8554/edge"
  }
}
