{
  "input": {
    "source": "http://192.168.10.12:8080/video",
    "loop": false,
    "width": 640,
    "height": 480,
    "target_fps": 15,
    "dump_interval_sec": 2
  },
  "detector": {
    "motion_mad_threshold": 8.0,
    "model_param": "models/yolo-fastest-v2.param",
    "model_bin": "models/yolo-fastest-v2.bin",
    "quantization": "auto",
    "model_candidates": {
      "fp32": {
        "param": "models/yolo-fastest-v2.param",
        "bin": "models/yolo-fastest-v2.bin"
      },
      "fp16": {
        "param": "models/yolo-fastest-v2-fp16.param",
        "bin": "models/yolo-fastest-v2-fp16.bin"
      },
      "int8": {
        "param": "models/yolo-fastest-v2-int8.param",
        "bin": "models/yolo-fastest-v2-int8.bin"
      }
    },
    "input_size": 320,
    "conf_threshold": 0.5,
    "num_threads": 2,
    "target_labels": [
      "person"
    ]
  },
  "event": {
    "end_grace_sec": 5
  },
  "llm": {
    "enabled": true,
    "endpoint": "http://192.168.10.10:8080/v1/chat/completions",
    "model": "vlm-local",
    "quantization": "auto",
    "model_candidates": {
      "q8": "vlm-local-q8",
      "q5": "vlm-local-q5",
      "q4": "vlm-local-q4"
    },
    "prompt": "用一句简短的中文描述画面中人物正在做什么。",
    "cooldown_sec": 15,
    "connect_timeout_sec": 3,
    "read_timeout_sec": 25,
    "jpeg_quality": 70
  },
  "storage": {
    "enabled": true,
    "endpoint": "http://192.168.10.10:8090/api/v1/events",
    "timeout_sec": 5
  },
  "streamer": {
    "mode": "mjpeg",
    "http_port": 8081,
    "rtsp_url": "rtsp://127.0.0.1:8554/edge"
  }
}
